# Optional: pg_dump outside the scheduler (use with mdhub-backup.timer if the worker's
# 02:00 `maintenance mode=backup` rule is not wanted, e.g. backups to a separate disk).
[Unit]
Description=market-data-hub pg_dump backup (keep 14)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=mdhub
Group=mdhub
WorkingDirectory=/opt/mdhub
EnvironmentFile=/etc/mdhub/mdhub.env
Environment=MDHUB_BACKUP_DIR=/var/backups/mdhub
ExecStart=/opt/mdhub/.venv/bin/mdhub ops backup --keep 14
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/mdhub
