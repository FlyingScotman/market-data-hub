# market-data-hub environment (DESIGN §7). Copy to deploy/.env (docker compose) or
# /etc/mdhub/mdhub.env (systemd), fill in, chmod 600. Never commit the filled file.
# Empty credential/URL values mean "unset". Optional non-secret knobs are commented out:
# uncomment them only with a value (an empty number/bool/zone would fail validation).

# ----------------------------------------------------------------- PostgreSQL (compose)
# Owner role/database created by the postgres container on first start.
POSTGRES_DB=
POSTGRES_USER=
# Long random URL-safe value (e.g. `openssl rand -hex 24`); used inside MDHUB_DATABASE_URL.
POSTGRES_PASSWORD=
# Read-only role for backend consumers (SELECT only). Empty password = NOLOGIN role.
MDHUB_RO_USER=
MDHUB_RO_PASSWORD=
# Passwords of the least-privilege roles of api, admin and hostmon (README_DEPLOY §16), each a
# long random URL-safe value. Unset: that service connects as the owner and logs a warning.
# Setting one on an existing install also needs sql/service_roles.sql run once (§16).
MDHUB_API_DB_PASSWORD=
MDHUB_ADMIN_DB_PASSWORD=
MDHUB_HOSTMON_DB_PASSWORD=
# Host ports, bound to 127.0.0.1 only (defaults 5432 / 8080).
MDHUB_PG_HOST_PORT=
MDHUB_API_HOST_PORT=
# Host directory for nightly dumps (default ./backups; must be writable by uid 10001).
MDHUB_BACKUP_HOST_DIR=
# Image tag built/used by compose (default latest). With self-update (README_DEPLOY §13) the
# release version, e.g. 0.2.0; the updater rewrites this line when it switches versions.
MDHUB_IMAGE_TAG=
# Version reported by images built from a git checkout (a release bundle carries its own,
# from its git tag; default 0.0.0).
#MDHUB_VERSION=

# ---------------------------------------------------------------------- application
# libpq URL. Compose sets it automatically from POSTGRES_*; set it here for systemd /
# bare metal, e.g. postgresql:///mdhub?host=/var/run/postgresql (peer auth, no password).
MDHUB_DATABASE_URL=
# Business time zone (default Europe/Moscow).
#MDHUB_TZ=
# Optional egress proxy URL for all source HTTP requests (may contain credentials).
MDHUB_HTTP_PROXY=
# MOEX ISS/APIM requests per second per host (default 3).
#MDHUB_ISS_RPS=
# Days to keep intraday raw captures (endpoint 'intraday:*'); EOD/static raw is kept forever (default 90).
#MDHUB_RAW_RETENTION_DAYS_INTRADAY=
# Days to keep re-read captures (endpoint 'intraday:reread:*', AlgoPack whole-day re-reads; default 7).
#MDHUB_RAW_RETENTION_DAYS_REREAD=
# Minutes between AlgoPack whole-day re-reads; polls in between read only the latest bars (default 30).
#MDHUB_ALGOPACK_FULL_REREAD_MINUTES=
# AlgoPack rolling window in calendar days (tradestats, FUTOI and their raw captures; older rows
# are deleted by the nightly retention, gap scan and backfill ignore older days; default 90).
#MDHUB_ALGOPACK_RETENTION_DAYS=
# Comma-separated bearer tokens accepted by the read API besides the named tokens of
# `mdhub tokens create` (preferred): `token` (shown as env:N) or `name=token`
# (`openssl rand -hex 32` each). Env tokens have all scopes.
MDHUB_API_TOKENS=
# Days of API request log, source probes and worker heartbeats kept (default 90).
#MDHUB_OPS_LOG_RETENTION_DAYS=
# Enable the MOEX SDFI swap-curve loader (needs a subscription; default false).
#MDHUB_ENABLE_SDFI=
# Comma list of source codes the reference-rate fallback chains skip (default none), e.g.
# bundesbank,fred when `mdhub probe-sources` shows them blocked from this server.
#MDHUB_SKIP_SOURCES=
# Logging level: DEBUG, INFO, WARNING, ERROR (default INFO).
#MDHUB_LOG_LEVEL=
# HTTP timeout in seconds (default 30).
#MDHUB_HTTP_TIMEOUT=
# Read-API database connection pool size per API process (default 8).
#MDHUB_API_POOL_SIZE=
# Published snapshots (DESIGN §11). Cut times are an owner decision (DEC04); MSK HH:MM.
# Daily static snapshot (default 07:45), market eod_preliminary for D (19:45),
# eod_final for D-1 next morning (08:00).
#MDHUB_SNAPSHOT_STATIC_TIME=
#MDHUB_SNAPSHOT_EOD_PRELIMINARY_TIME=
#MDHUB_SNAPSHOT_EOD_FINAL_TIME=
# Intraday market cuts every N minutes (divides 60; 0 = off; default 30) inside the window
# (whole hours, default 10:00-19:00); intraday snapshots are deleted after N days (default 30).
#MDHUB_SNAPSHOT_INTRADAY_MINUTES=
#MDHUB_SNAPSHOT_INTRADAY_WINDOW=
#MDHUB_SNAPSHOT_RETENTION_DAYS_INTRADAY=
# eod_final waits up to N minutes for the final bonds_eod / zcyc runs of D, then publishes with
# stale reasons (0 = no wait; default 30).
#MDHUB_SNAPSHOT_EOD_FINAL_WAIT_MINUTES=
# A backfill that changes inputs of a day that already has an eod_final queues a rebuild of that
# cut; a correction (supersedes) is published only when the content changes (default true).
#MDHUB_SNAPSHOT_AUTOCORRECT=
# Preliminary bonds EOD (19:20 bonds_eod mode=prelim): ISS publishes the history of D only
# overnight, so the run re-checks every N minutes (default 5) until the history has at least
# MIN_ROWS rows (default 1000) or the deadline (MSK HH:MM, default 19:40, before the 19:45
# eod_preliminary cut) passes; then it ends `partial` and the eod_preliminary cut publishes the
# bonds from the latest intraday marketdata (coverage basis = intraday_close).
#MDHUB_BONDS_EOD_PRELIM_MIN_ROWS=
#MDHUB_BONDS_EOD_PRELIM_DEADLINE=
#MDHUB_BONDS_EOD_PRELIM_RETRY_MINUTES=
# End-of-day curve rule (eod cuts and /v1/history/curves rule=eod): per day and source the latest
# quote set WITH bid/ask whose source clock is on the day at or before this MSK time (default
# 19:00); without one, the latest quote set of the day (labelled mid_only when it is).
#MDHUB_CURVE_EOD_CUTOFF=
# Directory for `maintenance mode=backup` dumps (default /var/backups/mdhub; compose: fixed).
MDHUB_BACKUP_DIR=

# -------------------------------------------------------------------- source credentials
# These can instead be set in the admin console (page Credentials, ADMIN_DESIGN §9): a console
# value wins over this file. `mdhub secrets import-env` (in the worker container) moves the
# values below into the store, after which these lines can be emptied.
# Worker only (compose blanks it for every other service): X25519 private key that opens the
# credentials set in the console. Create it with `mdhub secrets init-key`, rotate with
# `mdhub secrets rotate-key`. Back it up with this file: without it the stored credentials
# must be entered again (README_DEPLOY §14).
MDHUB_SECRETS_PRIVATE_KEY=
# MOEX APIM / AlgoPack bearer token.
MOEX_API_KEY=
# MOEX Passport (optional; account currently not realtime-entitled).
MOEX_PASSPORT_LOGIN=
MOEX_PASSPORT_PASSWORD=
# Ratescalcs basic auth (GET only).
RATESCALC_USERNAME=
RATESCALC_PASSWORD=
# Cbonds JSON API (optional enrichment; job skips while auth returns 401).
CBONDS_LOGIN=
CBONDS_PASSWORD=
# OTC Monitor bearer token (swaps_otc_monitor: RUONIA OIS, KRS, CNY xccy, CNY OIS vs
# RUSFAR CNY; the job is skipped while unset).
OTC_MONITOR_TOKEN=

# ------------------------------------------------------------------- admin console
# The compose service `admin` does not read this file as a whole: it gets only
# MDHUB_DATABASE_URL, the MDHUB_ADMIN_* values below, MDHUB_LOG_LEVEL, MDHUB_TZ and the machine
# monitoring settings (MDHUB_HOSTMON_*, MDHUB_NTP_SERVER) - never the
# source credentials or MDHUB_API_TOKENS ("Run now" in the console is executed by the worker).
# Host name of the console (WebAuthn RP ID; passkeys are bound to it - changing it later
# invalidates every passkey). Compose profile "tls" serves it through Caddy.
MDHUB_ADMIN_DOMAIN=
# Origin of the console, only for non-standard setups (default https://<MDHUB_ADMIN_DOMAIN>;
# local development: http://localhost:8081 with MDHUB_ADMIN_DOMAIN=localhost).
MDHUB_ADMIN_ORIGIN=
# Client networks allowed to reach the console, space-separated CIDRs (e.g. office and home
# IPs: "203.0.113.7/32 198.51.100.0/24"). Checked by Caddy and again by the app. Empty =
# every request refused.
MDHUB_ADMIN_ALLOW_CIDRS=
# Peers whose X-Forwarded-For the console uses (compose sets Caddy's fixed address; bare
# metal behind a local Caddy: 127.0.0.1).
MDHUB_ADMIN_TRUSTED_PROXIES=
# 32 random bytes encrypting TOTP secrets at rest: `openssl rand -hex 32`. Rotate with
# `mdhub admin rotate-key`.
MDHUB_ADMIN_SECRET_KEY=

# ------------------------------------------------------------------------ self-update
# The compose service `updater` (README_DEPLOY §13) does not read this file as a whole either:
# it gets the database URL, the values below, MDHUB_HTTP_PROXY, MDHUB_LOG_LEVEL and MDHUB_TZ.
# Host directory with releases/, current, archives/ and shared/ (default /opt/mdhub); mounted
# at the same path in the updater container.
#MDHUB_UPDATE_ROOT=
# GitHub repository of the signed releases (default FlyingScotman/market-data-hub).
#MDHUB_UPDATE_GITHUB_REPO=
# Absolute host path to the persistent site Compose override; used throughout updates.
#MDHUB_UPDATE_COMPOSE_OVERRIDE=
# Fine-grained GitHub token with contents:read on that one repository. Put it into
# shared/updater.env (linked as deploy/updater.env), NOT into this file: every service that
# reads .env would see it. Without it the console offers uploads only.
#MDHUB_UPDATE_GITHUB_TOKEN=
# Upload volume shared by the console and the updater (default /var/lib/mdhub/uploads).
#MDHUB_UPDATE_UPLOAD_DIR=
# Read API as the updater reaches it for its post-update checks (default http://api:8080).
#MDHUB_UPDATE_API_URL=

# ----------------------------------------------------------------- machine monitoring
# Read by the compose services `hostmon` (host sampler, no other settings and no
# credentials) and `admin` (states on the Machine page); ADMIN_DESIGN §10.
# Host paths of the file systems shown on the Machine page, comma-separated (default /).
# Add the docker data root and the backup directory when they are separate file systems,
# e.g. "/,/var/lib/docker,/srv/mdhub-backups".
#MDHUB_HOSTMON_MOUNTS=
# SNTP server for the clock offset check (default pool.ntp.org; "off" disables it).
#MDHUB_NTP_SERVER=
# Thresholds (defaults in parentheses): disk/inodes used warn (80) and crit (90) percent,
# warn when the 7-day trend fills a disk within N days (14).
#MDHUB_HOSTMON_DISK_WARN_PCT=
#MDHUB_HOSTMON_DISK_CRIT_PCT=
#MDHUB_HOSTMON_DISK_FULL_DAYS=
# Memory available below N percent: crit (10); swap in use above N percent: warn (50).
#MDHUB_HOSTMON_MEM_AVAILABLE_MIN_PCT=
#MDHUB_HOSTMON_SWAP_MAX_PCT=
# CPU steal 5-minute average above N percent (10); 5-minute load above N x cores (2).
#MDHUB_HOSTMON_STEAL_MAX_PCT=
#MDHUB_HOSTMON_LOAD_PER_CORE_MAX=
# Clock offset against the SNTP server above N seconds: crit (1).
#MDHUB_HOSTMON_CLOCK_OFFSET_MAX_S=
# PostgreSQL connections above N percent of max_connections (80); a transaction open longer
# than N minutes (30).
#MDHUB_HOSTMON_PG_CONNECTIONS_MAX_PCT=
#MDHUB_HOSTMON_PG_XACT_MAX_MINUTES=

# ------------------------------------------------------------------ TLS proxy (Caddy)
# Public DNS name of the API (compose profile "tls" / bare-metal Caddy) and ACME e-mail.
MDHUB_API_DOMAIN=
ACME_EMAIL=
