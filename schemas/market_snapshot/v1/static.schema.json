            {
              "$ref": "common.schema.json#/$defs/date"
            }
          ]
        },
        "valid_to": {
          "description": "Last day of the covered range; outside [valid_from, valid_to] the calendar is unknown",
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/date"
            }
          ]
        },
        "provisional_from": {
