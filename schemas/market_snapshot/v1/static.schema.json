    "zcyc_reproduction": {
      "description": "1.4: reproduction of the published KBD floater coupons. method fit: the hub searched tenor and fixing offset (tested terms below; published in the formula only when accepted); check: the documented terms were tested. A coupon matches when the formula gives its rate within tolerance_pct. accepted: at least 80 % of at least 6 coupons after the first match (the first coupon is often set at placement), the latest coupon matches and, for a fit, no other tenor / offset does as well",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "tenor_years",
        "fixing_offset",
        "periods_checked",
        "periods_matched",
        "unmatched_coupon_nos",
        "tolerance_pct",
        "max_abs_error_pct",
        "checked_through",
        "accepted",
        "reason"
      ],
      "properties": {
        "method": {
          "enum": [
            "fit",
            "check"
          ]
        },
        "tenor_years": {
          "$ref": "common.schema.json#/$defs/decimal_or_null"
        },
        "fixing_offset": {
          "type": [
            "integer",
            "null"
          ]
        },
        "periods_checked": {
          "type": "integer",
          "minimum": 0
        },
        "periods_matched": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_coupon_nos": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "tolerance_pct": {
          "$ref": "common.schema.json#/$defs/decimal"
        },
        "max_abs_error_pct": {
          "$ref": "common.schema.json#/$defs/decimal_or_null"
        },
        "checked_through": {
          "description": "Start date of the latest coupon checked",
          "$ref": "common.schema.json#/$defs/date_or_null"
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "description": "Why not accepted; null when accepted",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
