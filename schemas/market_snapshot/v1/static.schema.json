    "rating": {
      "description": "Credit rating as known at known_at: issue scope from ref.bond_rating (Cbonds; 1.3: NKR, NRA, RA Expert by ISIN), issuer scope (1.3) from ref.issuer_rating (agencies by INN; RA Expert regions through the ISINs of their rated bonds). Values verbatim from the source, nothing inferred; a withdrawn rating carries rating null and action withdrawn (1.1, HS5; 1.3, P1-1)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "secid",
        "issuer_id",
        "agency",
        "scale",
        "rating",
        "grade",
        "outlook",
        "watch",
        "rating_date",
        "action",
        "source",
        "rating_type",
        "press_release",
        "mapping_basis"
      ],
      "properties": {
        "scope": {
          "description": "issue: rating of the bond secid; issuer: rating of issuer_id",
          "enum": [
            "issue",
            "issuer"
          ]
        },
        "secid": {
          "description": "scope issue: the rated bond; issuer: null",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/secid"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "agency": {
          "description": "Agency display name: НКР, НРА, Эксперт РА (agency sources), or as Cbonds names it",
          "type": "string"
        },
        "scale": {
          "description": "Rating scale: national_ru (national scale for the Russian Federation; agency sources) or as Cbonds names it; empty string when the source gives none",
          "type": "string"
        },
        "rating": {
          "description": "Rating verbatim (ruAA-, AA-.ru, AA–|ru|, ...); null when withdrawn",
          "type": [
            "string",
            "null"
          ]
        },
        "grade": {
          "description": "Letter grade of the national-scale rating without the agency's scale marks (AAA, AA+, ..., D), by the documented rule mdhub.sources.ratings_common.normalize_grade (Cyrillic look-alikes and dashes mapped to ASCII); null when the rating is not such a grade (withdrawn, expected, ESG, Cbonds rows) (1.3)",
          "type": [
            "string",
            "null"
          ]
        },
        "outlook": {
          "type": [
            "string",
            "null"
          ]
        },
        "watch": {
          "description": "Review / watch status verbatim (НКР 'рейтинг на пересмотре …', НРА 'Под наблюдением', Эксперт РА 'Рейтинг под наблюдением'); null when none or not published",
          "type": [
            "string",
            "null"
          ]
        },
        "rating_date": {
          "$ref": "common.schema.json#/$defs/date_or_null"
        },
        "action": {
          "description": "Rating action: assigned | affirmed | upgraded | downgraded | withdrawn | outlook_changed when the source publishes the action (NRA status, withdrawn lists); null when it does not (never derived from consecutive ratings)",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Hub source of the row: cbonds | nkr | nra | raexpert",
          "type": "string"
        },
        "rating_type": {
          "description": "Agency's rating type / list verbatim (e.g. Рейтинги кредитоспособности нефинансовых компаний); null for Cbonds rows (1.3)",
          "type": [
            "string",
            "null"
          ]
        },
        "press_release": {
          "description": "URL of the agency press release of the latest action; null when unknown (1.3)",
          "type": [
            "string",
            "null"
          ]
        },
        "mapping_basis": {
          "description": "How the agency's object was matched to MOEX: isin (issue) | inn (issuer) | region_bond_isin (RA Expert region via the ISINs of its rated bonds); null for Cbonds rows (1.3)",
          "enum": [
            "isin",
            "inn",
            "region_bond_isin",
            null
          ]
        }
      }
    },
